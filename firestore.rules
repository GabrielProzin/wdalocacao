rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && (request.auth.uid == "k6LREoqj4EOLH2GuSGK6xZufcYo1"
         || request.auth.uid == "UEfqLWgUlEYEOMSxoQKe4z3pbEA2");
    }
    match /aluguel/{aluguelId} {
  allow read, write: if request.auth != null
    && request.auth.uid == "WDsd2VbWlAgrF6J4JkRPXj6PRBu2";
}
    match /despesas/{despesaId} {
      function contaDeTeste() {
        return request.auth != null
          && request.auth.uid == "WDsd2VbWlAgrF6J4JkRPXj6PRBu2";
      }
      function dadosValidos() {
        let d = request.resource.data;
        return d.keys().hasAll(['tipo', 'valorCentavos', 'data', 'litros', 'observacao'])
          && d.keys().hasOnly(['tipo', 'valorCentavos', 'data', 'litros', 'observacao'])
          && d.tipo in ['combustivel', 'materiais', 'manutencao', 'outros']
          && d.valorCentavos is int && d.valorCentavos > 0 && d.valorCentavos <= 1000000000
          && d.data is string
          && d.data.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.observacao is string && d.observacao.size() <= 200
          && (d.litros == null || (d.tipo == 'combustivel' && d.litros is number && d.litros > 0 && d.litros <= 100000));
      }
      allow read, delete: if contaDeTeste();
      allow create, update: if contaDeTeste() && dadosValidos();
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
